[user]
	name = GreatSharky
	email = aaro.haikonen99@gmail.com

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = simple

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[help]
	autocorrect = prompt
